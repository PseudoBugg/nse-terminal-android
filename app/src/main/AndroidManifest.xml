<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ZERO PERMISSION ARCHITECTURE
         By utilizing the modern Android Storage Access Framework (SAF) via 
         ActivityResultContracts.OpenDocument, this application requires ZERO 
         storage permissions (No READ_EXTERNAL_STORAGE, No MANAGE_EXTERNAL_STORAGE).
         Completely offline-first and private. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NSE Terminal"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NSETerminal">
        
        <!-- Activity configured for both Phone & Tablet orientations (full sensor rotation) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.NSETerminal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
